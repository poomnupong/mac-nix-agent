# Hermes Agent - CLI Configuration
# Copied to config.yaml on first start. The live file is gitignored because
# Hermes and its dashboard may rewrite it as settings change.

model:
  default: gemma-4-31b-it-mxfp8
  provider: omlx
  base_url: http://192.168.64.1:8000/v1
  context_length: 65536
providers:
  omlx:
    name: oMLX (local)
    base_url: http://192.168.64.1:8000/v1
    key_env: OMLX_API_KEY
agent:
  max_turns: 60
  verify_on_stop: false
  reasoning_effort: medium
terminal:
  backend: local
  cwd: /opt/data/workspace
  timeout: 300
  lifetime_seconds: 300
web:
  search_backend: searxng
display:
  tool_progress: all
dashboard:
  theme: default
memory:
  memory_enabled: true
  user_profile_enabled: true
approvals:
  mode: smart
_config_version: 33
fallback_model:
  provider: ollama-cloud
  model: gemma4:31b
plugins:
  enabled: []

# Secret redaction and tirith pre-exec scanning are enabled by default.
# Uncomment to override their defaults.
# security:
#   redact_secrets: true
#   tirith_enabled: true
#   tirith_path: "tirith"
#   tirith_timeout: 5
#   tirith_fail_open: true