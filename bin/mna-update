#!/bin/bash
# mac-nix-agent — update everything, verbosely
#
# Why this exists: `darwin-rebuild switch` runs `brew update && brew upgrade`
# SILENTLY during activation (homebrew.onActivation.upgrade = true). A big
# bottle (e.g. oMLX is a ~1.6 GB / 35k-file Python venv) can take many
# minutes with zero output, which looks like a hang. This script upgrades
# Homebrew with `--verbose` FIRST — so you see real progress — then bumps
# the flake and rebuilds (by which point brew has nothing left to do
# silently), and finally restarts oMLX onto its new binary.
#
# Usage: mna-update [--no-flake] [--no-brew]
#   --no-flake   skip `nix flake update` (rebuild against the pinned lock)
#   --no-brew    skip the explicit verbose `brew upgrade`

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

log()  { printf "\033[1;34m==>\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m!!\033[0m  %s\n" "$*" >&2; }
die()  { printf "\033[1;31mxx\033[0m  %s\n" "$*" >&2; exit 1; }

do_flake=1
do_brew=1
for arg in "$@"; do
    case "$arg" in
        --no-flake) do_flake=0 ;;
        --no-brew)  do_brew=0 ;;
        -h|--help)  sed -n '2,12p' "$0"; exit 0 ;;
        *) die "Unknown option: $arg (try --help)" ;;
    esac
done

# ── Load Homebrew onto PATH ──────────────────────────────
# home-manager's interactive rc doesn't run `brew shellenv`, so `brew`
# may be installed but not resolvable. Load it from the standard prefix.
if ! command -v brew >/dev/null 2>&1; then
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$b" ] && eval "$("$b" shellenv)" && break
    done
fi

# ── 1. Homebrew (verbose, so it's not the silent stall) ──
if [ "$do_brew" -eq 1 ] && command -v brew >/dev/null 2>&1; then
    log "Updating Homebrew metadata..."
    brew update
    outdated="$(brew outdated --quiet 2>/dev/null || true)"
    if [ -n "$outdated" ]; then
        log "Upgrading outdated formulae/casks (verbose):"
        printf '    %s\n' $outdated
        brew upgrade --verbose
    else
        log "Homebrew already up to date — skipping upgrade."
    fi
else
    [ "$do_brew" -eq 1 ] && warn "brew not found — skipping Homebrew upgrade."
fi

# ── 2. Flake inputs ──────────────────────────────────────
if [ "$do_flake" -eq 1 ]; then
    log "Bumping flake inputs (nix flake update)..."
    sudo nix flake update
else
    log "Skipping flake update (--no-flake) — rebuilding against pinned lock."
fi

# ── 3. Rebuild nix-darwin ────────────────────────────────
# brew was already upgraded above, so activation's silent brew step is a
# no-op here.
log "Applying nix-darwin flake (sudo)..."
if command -v darwin-rebuild >/dev/null 2>&1; then
    sudo darwin-rebuild switch --flake "$REPO_DIR"
else
    sudo nix run nix-darwin#darwin-rebuild -- switch --flake "$REPO_DIR"
fi

# ── 4. Restart oMLX onto the new binary ──────────────────
# A running oMLX process keeps the OLD binary until restarted, so any
# `brew upgrade omlx` above only takes effect after this.
if command -v brew >/dev/null 2>&1 && brew list --versions jundot/omlx/omlx >/dev/null 2>&1; then
    log "Restarting oMLX onto current binary..."
    brew services restart jundot/omlx/omlx >/dev/null 2>&1 || warn "oMLX restart failed — run 'mna-doctor --fix'."
fi

printf "\n\033[1;32mUpdate complete.\033[0m  Verify oMLX with: mna-omlx status\n"
